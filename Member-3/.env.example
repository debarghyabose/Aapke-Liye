# Copy to .env and fill in real values. Never commit .env.

# Damage vision (Phase 1). Choose: gemini (free tier) | claude (paid credits)
VISION_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Tried in order: if one is busy or rate-limited, the next is used
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
VISION_DEADLINE_SECONDS=25

# Claude: key from console.anthropic.com (needs credits)
VISION_API_KEY=
VISION_MODEL=claude-opus-5-5
VISION_EFFORT=medium

# Dashboard data for Member 5. Set a long random key before sharing this server:
# /dashboard shows exact victim locations. Clients send it as the X-Dashboard-Key header.
DASHBOARD_API_KEY=
# Web pages allowed to read /dashboard from a browser. "null" = Member 5's dashboard opened
# straight from a file. In production, list only the real dashboard address.
DASHBOARD_CORS_ORIGINS=null,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://localhost:3000
# Advanced fraud checks (review flags only)
SAME_HOUSE_RADIUS_M=25
PHONE_MAX_OTHER_CLAIMS_24H=3
# Secret for phone-number fingerprints. Set a long random value in production;
# if empty, a random key is made once and kept in the database.
PHONE_HASH_KEY=
# Satellite / map checks (local files only; nothing is sent to outside services)
# Flood-extent polygons: Copernicus EMS or ISRO Bhuvan/NRSC, .geojson or .shp, comma-separated.
# Real Copernicus EMS data is in data/copernicus/ (see its README for the credit line), e.g.
# FLOOD_MAP_FILES=data/copernicus/EMSR104_andhra_flood_2014-10-12.geojson,data/copernicus/EMSR357_puri_flood_2019.geojson
# BUILDING_FILES=data/copernicus/EMSR357_puri_building_damage_2019.geojson
# data/demo/DEMO_synthetic_flood_extent.geojson is SYNTHETIC demo data (see data/demo/README.md).
FLOOD_MAP_FILES=
FLOOD_TOLERANCE_M=300
FLOOD_COVERAGE_MARGIN_KM=10
# Crop before/after check from Sentinel-2 (public images, no account; runs in the background)
NDVI_ENABLED=true
NDVI_RADIUS_M=30
# Building footprints: Google Open Buildings CSV or OpenStreetMap GeoJSON, comma-separated.
BUILDING_FILES=
BUILDING_SEARCH_M=30
# Where photo checks are saved (git ignores *.db)
MEMBER3_DB_PATH=member3.db

# Demo disaster zone (centre + radius) used until PostGIS zones exist
DISASTER_ZONE_LAT=22.5726
DISASTER_ZONE_LON=88.3639
DISASTER_ZONE_RADIUS_KM=50
DISASTER_START_DATE=2026-11-01

# WhatsApp bot through Twilio (see README "WhatsApp bot"). Never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Public https address Twilio calls (your tunnel), no path
PUBLIC_BASE_URL=
MEMBER2_API_URL=http://localhost:8000
WHATSAPP_STATUS_POLL_SECONDS=60

# IVR line uses the same Twilio settings (see README "IVR line").
# Exotel (Indian numbers) is not built yet:
EXOTEL_SID=
EXOTEL_TOKEN=
