# Copy to .env and fill in. Values below are safe placeholders for local development.
# Never commit .env.

# development | production. Production refuses to start with unsafe settings.
APP_ENV=development

# true = fake Member 1/3 answers from app/dev_mocks.py. Development only:
# the app refuses to start with MOCK_SERVICES=true in production.
MOCK_SERVICES=true

# Empty = SQLite file in this folder (development). Required in production (Postgres):
# DATABASE_URL=postgresql://aapke:CHANGE_ME@localhost:5432/aapke_liye
DATABASE_URL=

# Where encrypted uploads and PDFs are stored. Default: ./storage
# STORAGE_DIR=/data/storage

# Fernet key that encrypts stored audio, photos and PDFs. Required in production.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put the NEW key first, keep the old one after a comma until files are re-saved.
# Empty in development = a key is created in STORAGE_DIR/.dev-encryption-key
STORAGE_ENCRYPTION_KEY=yOkYdeFVdug01aXXWb5ktMRcHbOAk1uxYDJG-Ko0Ojc=

# Officials' keys for PUT /status and GET /staff/claims/{id}, as label:key pairs.
# The label (never the key) is written to the audit log. Required in production,
# each key at least 24 characters. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STAFF_API_KEYS=HSEt8ulm2WFZpRnRng22sRY8gg3OHB7T1y2d84Y4HzE

# Teammates' services. MEMBER1_AI_URL is required in production.
MEMBER1_AI_URL=http://localhost:8001
MEMBER3_VERIFY_URL=http://localhost:8002
# Read timeout for their replies (seconds). Each call is retried twice.
SERVICE_TIMEOUT_SECONDS=30

# Comma-separated frontend origins. "*" is refused in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Per-IP rate limits (slowapi syntax), per worker process.
RATE_LIMIT_CREATE=10/minute
RATE_LIMIT_UPLOAD=30/minute

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- docker-compose only ---
# POSTGRES_PASSWORD=CHANGE_ME
# Reverse proxy IP(s) whose X-Forwarded-For is trusted (for per-IP rate limits)
# FORWARDED_ALLOW_IPS=127.0.0.1
# Number of uvicorn worker processes
# WEB_CONCURRENCY=2
