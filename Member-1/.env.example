# Copy to .env and fill in. Never commit .env.

# live = Whisper (local) + Gemini; mock = offline rule-based stand-ins
CLAIM_AI_MODE=mock

# Gemini - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
# tried in order if the main model is overloaded or slower than LLM_TIMEOUT_S
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_TIMEOUT_S=15
# low | medium | high. Leave empty if the model rejects thinking_level.
LLM_THINKING_LEVEL=low

# Speech to text: Whisper runs on this computer, no key needed.
# large-v3-turbo (~1.6 GB, good balance) | large-v3 (~3 GB, most accurate) | small (~500 MB, fastest)
WHISPER_MODEL=large-v3-turbo
# auto picks the GPU if CUDA works, else CPU
WHISPER_DEVICE=auto
ASR_MIN_CONFIDENCE=0.45

# llm = Gemini phrases follow-ups; template = fixed reviewed sentences (faster)
QUESTION_MODE=llm
# 1 = speak questions aloud with gTTS (free, needs internet)
TTS_ENABLED=0
MAX_AUDIO_SECONDS=90
